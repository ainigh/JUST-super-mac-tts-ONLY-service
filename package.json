{
  "name": "super-face",
  "productName": "Super Face",
  "version": "0.1.0",
  "description": "The mouth and the face: a full-body 3D avatar on the Mac desktop that speaks what it's given (Kokoro, through HeadTTS) with lip-sync, expressions and gestures (TalkingHead), served over HTTP to any app. Super Voice is the ears and the model.",
  "main": "main.mjs",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/fetch-avatars.mjs",
    "start": "electron .",
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test test/*.test.mjs",
    "dist": "electron-builder --mac dir --arm64 --publish never && node scripts/package-mac.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@met4citizen/headtts": "1.3.0",
    "@met4citizen/talkinghead": "1.8.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.superface",
    "files": [
      "main.mjs",
      "preload.cjs",
      "src/**",
      "renderer/**",
      "API.md",
      "package.json",
      "node_modules/@met4citizen/**",
      "node_modules/three/build/**",
      "node_modules/three/examples/jsm/**",
      "node_modules/@huggingface/transformers/dist/**",
      "!node_modules/@huggingface/transformers/dist/*.node.*",
      "!**/*.map",
      "!renderer/dev-bridge.mjs",
      "!node_modules/onnxruntime-node/**",
      "!node_modules/sharp/**",
      "!node_modules/@img/**"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
